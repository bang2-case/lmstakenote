# Copy this file to .env or .env.local for local development.
# Never put real secrets in this example file.

# Optional if LMS_LOGIN_EMAIL/PASSWORD are set. Useful for quick local runs.
LMS_TOKEN=

# Used to refresh LMS_TOKEN automatically during Vercel builds.
FIREBASE_API_KEY=
LMS_LOGIN_EMAIL=
LMS_LOGIN_PASSWORD=

# Google Sheet export/fetch helpers.
GOOGLE_SHEET_ID=
