# Copy this file to .env or .env.local for local development.
# Never put real secrets in this example file.

# Optional if LMS_LOGIN_EMAIL/PASSWORD are set. Useful for quick local runs.
LMS_TOKEN=

# Used to refresh LMS_TOKEN automatically during Vercel builds.
FIREBASE_API_KEY=
LMS_LOGIN_EMAIL=
LMS_LOGIN_PASSWORD=

# Google Sheet export/fetch helpers.
GOOGLE_SHEET_ID=1Kfe54naRKeFnId08zCu9UGLIS7gzteJarahVP0zle5Y

# Supabase Postgres connection string for deploy/API cache.
DATABASE_URL=

# Keep local SQLite by default. Set USE_SUPABASE=1 on Vercel after syncing cache.
USE_SUPABASE=0

# Recommended on Vercel builds so deploy does not run a long LMS fetch.
SKIP_PREPARE_DATA=1
