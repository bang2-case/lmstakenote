{
  "framework": "vite",
  "buildCommand": "SKIP_PREPARE_DATA=1 npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.git/**,.github/**,.vscode/**,dist/**,node_modules/**,public/**,src/**,exports/**,classroom_data.db,*.db,*.db-wal,*.db-shm,main.py,*.log}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
